# ============================================================
# Productivity-Friend — Environment Variables Template
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# NEVER commit .env to git — it is listed in .gitignore.
# ============================================================


# ── Anthropic / Claude ──────────────────────────────────────
# Get your key at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...


# ── Microsoft Azure App Registration ────────────────────────
# ============================================================
# OPTION A: Personal @outlook.com account (SIMPLER — start here)
# ============================================================
# Only CLIENT_ID is needed. No secret, no tenant ID.
# The tool will prompt you to sign in via browser on first run.
# Token is cached at ~/.productivity_friend_token_cache.json
#
# Setup (~5 min):
#   1. Go to https://portal.azure.com
#      (sign in with ANY Microsoft account, including personal @outlook.com)
#   2. Search "App registrations" → New registration
#   3. Name: "Productivity-Friend"
#   4. Supported account types:
#      ✓ "Personal Microsoft accounts only"  (just your @outlook.com)
#      or "Accounts in any organizational directory and personal accounts"
#   5. Redirect URI: leave blank
#   6. Click Register → copy the "Application (client) ID" below
#   7. API permissions → Add a permission → Microsoft Graph → Delegated:
#        Mail.Read, Mail.ReadWrite, Calendars.Read, User.Read
#      (No admin consent needed — you'll consent when you sign in)
#
CLIENT_ID=your-azure-app-client-id

# ============================================================
# OPTION B: Corporate M365 / Azure AD account
# ============================================================
# Uncomment and fill in all three. Uses app-only auth (no browser sign-in).
# Requires Application permissions granted by your IT admin:
#   Mail.Read, Mail.ReadWrite, Calendars.Read, User.Read.All
#
# TENANT_ID=your-azure-tenant-id
# CLIENT_SECRET=your-azure-client-secret


# ── Truv API Credentials ─────────────────────────────────────
# Used by:
#   - Webhook signature verification (/truv/webhook endpoint)
#   - Truv API health check panel in the dashboard
#
# Get your credentials from the Truv Dashboard:
#   https://dashboard.truv.com/settings/api-keys
#
# IMPORTANT: These belong in HTTP request HEADERS (X-Access-Client-Id
# and X-Access-Secret), NOT in the JSON body. The validator will warn
# you if customers put credentials in their JSON payloads.
#
TRUV_CLIENT_ID=your-truv-client-id
TRUV_ACCESS_SECRET=your-truv-access-secret

# Truv environment to target: sandbox | development | production
TRUV_ENVIRONMENT=sandbox


# ── n8n Integration (Beelink Mini PC) ───────────────────────
# Your self-hosted n8n instance URL.
# Default n8n port is 5678.
#
# Example: N8N_BASE_URL=http://192.168.1.100:5678
#
N8N_BASE_URL=http://localhost:5678

# n8n API key — used when calling the n8n REST API directly.
# Find it in: n8n → Settings → n8n API → Create API key
N8N_API_KEY=your-n8n-api-key

# Webhook secret — n8n sends this in the X-N8N-SECRET header when
# calling /n8n/webhook. Set the same value in your n8n HTTP Request node.
N8N_WEBHOOK_SECRET=choose-a-random-secret-string

# n8n workflow ID that handles Truv webhook events (optional).
# When a Truv webhook arrives at /truv/webhook, this orchestrator will
# forward it to n8n for further automation (reply emails, CRM update, etc.)
N8N_TRUV_WEBHOOK_WORKFLOW_ID=your-n8n-workflow-id


# ── API Server (api_server.py / FastAPI) ─────────────────────
# Start with: uvicorn api_server:app --host 0.0.0.0 --port 8000 --reload

# Port the FastAPI server listens on (default: 8000)
API_SERVER_PORT=8000

# Optional Bearer token for API endpoints.
# Set this to a random string to protect the server from unauthorized access.
# Leave blank during local development for convenience.
API_SERVER_SECRET=

# TruvBrain Vercel URL — added to CORS allowed origins so the dashboard
# can reach the API server from production.
# Example: TRUV_BRAIN_ORIGIN=https://your-app.vercel.app
TRUV_BRAIN_ORIGIN=


# ── Optional / Debug ─────────────────────────────────────────

# Outlook user to scan (default: "me" = the signed-in account)
# OUTLOOK_USER_ID=me

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
