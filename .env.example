# ============================================================
# Productivity-Friend — Environment Variables Template
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# NEVER commit .env to git.
# ============================================================

# ── Anthropic / Claude ──────────────────────────────────────
# Get your key at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# ── Microsoft Azure App Registration ────────────────────────
# Create an app at: https://portal.azure.com → Azure Active Directory
#   → App registrations → New registration
# Required API permissions (Application permissions, not Delegated):
#   - Mail.Read
#   - Mail.ReadWrite    (needed to create draft replies and flag messages)
#   - Mail.Send         (optional: to send approved draft responses)
#   - Calendars.Read
#   - User.Read.All     (if accessing other users' mailboxes)
CLIENT_ID=your-azure-app-client-id
TENANT_ID=your-azure-tenant-id
CLIENT_SECRET=your-azure-client-secret

# ── Optional ─────────────────────────────────────────────────
# Outlook user to scan (default: "me" for the service account)
# OUTLOOK_USER_ID=me

# Logging level: DEBUG | INFO | WARNING | ERROR
# LOG_LEVEL=INFO
