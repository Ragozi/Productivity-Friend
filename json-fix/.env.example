# ─────────────────────────────────────────────
#  JSON_FIX — Environment Configuration
#  Copy this file to .env and fill in values.
#  Never commit .env to git.
# ─────────────────────────────────────────────

# ── Truv API Credentials ──────────────────────
# Get these from your Truv dashboard (sandbox tab)
TRUV_CLIENT_ID=
TRUV_ACCESS_SECRET=

# "sandbox" or "production"
TRUV_ENV=sandbox

# Override API base URLs only if needed
# TRUV_BASE_URL=https://prod.truv.com/v1
# TRUV_SANDBOX_URL=https://sandbox.truv.com/v1

# ── Productivity-Friend Integration ───────────
# URL of the Productivity-Friend api_server (port 8000).
# On Beelink: leave as localhost. On another machine: use its IP.
# Set to empty string to disable deep schema validation.
PRODUCTIVITY_FRIEND_URL=http://localhost:8000

# ── Storage ───────────────────────────────────
# Paths for output files and logs. Defaults to json-fix/output/ and json-fix/logs/
# OUTPUT_DIR=output
# LOG_DIR=logs

# Max upload size in MB (default 10)
# MAX_UPLOAD_MB=10
